# Chaves lidas pelo serviço (formato KEY=value)

SESSION_SECRET=
NEXTAUTH_URL=
NEXTAUTH_SECRET=

ADFS_ENTRY_POINT=
ADFS_ISSUER=
ADFS_CALLBACK_URL=
ADFS_SP_ISSUER=
ADFS_CERT=
ADFS_METADATA_URL=

# Cliente OAuth interno (app-exemplo neste serviço).
# SSO_CLIENT_ID=app-exemplo
# SSO_CLIENT_SECRET=
# SSO_CLIENT_NAME=App Exemplo
# SSO_CLIENT_REDIRECT_URI=https://seu-host.ngrok-free.dev/app-exemplo/callback

# Cliente OAuth da aplicação genérica adfs-sso-random-app (porta 3001).
SSO_RANDOM_APP_CLIENT_ID=random-app
SSO_RANDOM_APP_CLIENT_SECRET=dev-random-app-secret
SSO_RANDOM_APP_NAME=Random App
SSO_RANDOM_APP_REDIRECT_URI=http://localhost:3001/auth/callback

# Outras apps: JSON. Faz merge com os clientes acima (mesmo id substitui).
# SSO_CLIENTS=[{"id":"app-b","secret":"...","name":"App B","redirectUris":["https://app-b.exemplo/callback"]}]
